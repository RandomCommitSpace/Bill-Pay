<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beauBlue"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="24dp"
    android:textDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="📄 لیست قبض‌ها"
        android:textColor="@color/metallicBlue"
        android:textSize="22sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:layoutDirection="rtl"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <ListView
            android:id="@+id/listBills"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/metallicBlue"
            android:divider="@color/blueGray"
            android:dividerHeight="1dp"
            android:layoutDirection="rtl"
            android:padding="12dp" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💳 پرداخت قبض انتخاب‌شده"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/metallicBlue"
        app:cornerRadius="16dp"
        app:elevation="6dp"
        app:rippleColor="@color/blueGray" />

</LinearLayout>
